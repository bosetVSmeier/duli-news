# ============================================================
# IndieRadar 环境变量模板
# 用法：复制为 .env 并填入真实值。本地不填 = 内存+Mock 模式，零依赖可跑。
# 生产（Render）把这些填到 Render 控制台的 Environment Variables。
# ============================================================

# ---- 服务端口（容器里用 8080，本地 dotnet run 可忽略）----
ASPNETCORE_HTTP_PORTS=8080

# ---- 数据库模式：memory（本地演示）| postgres（生产）----
DB_MODE=postgres

# ---- Postgres 连接串 ----
# 本地 Docker：Host=localhost;Port=5432;Database=indieradar;Username=indieradar;Password=indieradar_dev_pwd
# Neon 生产：从 Neon 控制台复制 Connection String（形如 postgresql://user:pass@host/db?sslmode=require）
CONNECTION_STRING=Host=localhost;Port=5432;Database=indieradar;Username=indieradar;Password=indieradar_dev_pwd

# ---- AI 模式：mock（本地演示）| real（真实模型）----
LLM_MODE=real

# ---- 主模型：Hy4 flash（腾讯云 TokenHub，5折至 2026-12-31）----
# Key 在 https://console.cloud.tencent.com/tokenhub/apikey 创建
LLM_PRIMARY_NAME=hy4-flash
LLM_PRIMARY_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_PRIMARY_API_KEY=填你的TokenHub密钥
LLM_PRIMARY_MODEL_ID=hy4-flash

# ---- 兜底模型：GLM-4-Flash（智谱，永久免费）----
# Key 在 https://open.bigmodel.cn 创建
LLM_FALLBACK_NAME=glm-4-flash
LLM_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_FALLBACK_API_KEY=填你的智谱密钥
LLM_FALLBACK_MODEL_ID=glm-4-flash

# ---- AI 相关度阈值（0-100，越高越严格）----
AI_SCORE_THRESHOLD=60
